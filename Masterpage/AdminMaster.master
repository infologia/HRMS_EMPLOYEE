    <style>
        /* ===== HEADER ===== */
        .header-color {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
            box-shadow: 0 2px 20px rgba(102,126,234,0.3) !important;
            border-bottom: none !important;
        }

        .navbar.navbar-fixed-top {
            height: 56px;
            min-height: 56px;
            border-radius: 0 0 20px 0;
        }

        .navbar-inverse {
            border-bottom: 0 !important;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 18px;
        }

        .navbar-brand .brand-icon {
            height: 32px;
            width: auto;
            border-radius: 8px;
        }

        .brand-text {
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .navbar-inverse .navbar-nav > li > a {
            color: rgba(255,255,255,0.9);
            transition: all 0.2s;
        }
        .navbar-inverse .navbar-nav > li > a:hover {
            color: #ffffff;
            background: rgba(255,255,255,0.15);
            border-radius: 8px;
        }

        /* User dropdown */
        .dropdown-user > a {
            display: flex !important;
            align-items: center;
            gap: 8px;
            padding: 5px 12px !important;
            border-radius: 20px;
            background: rgba(255,255,255,0.2);
            transition: background 0.2s;
        }
        .dropdown-user > a:hover {
            background: rgba(255,255,255,0.3) !important;
        }
        .dropdown-user img {
            height: 30px;
            width: 30px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.5);
        }
        .navbar-nav > li.dropdown-user > a {
            margin-top: 4px !important;
        }
        .navbar-inverse .navbar-nav > .dropdown-user > .dropdown-menu {
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(102,126,234,0.2);
            border: none;
            overflow: hidden;
            margin-top: 8px;
        }

        /* ===== SIDEBAR ===== */
        .sidebar-main {
            background: linear-gradient(180deg, #f8f9ff 0%, #f0f2ff 100%) !important;
            box-shadow: 3px 0 20px rgba(102,126,234,0.1);
            border-right: 1px solid #e8ecff;
        }

        .sidebar-content {
            background: transparent !important;
        }

        /* Sidebar user section */
        .sidebar-user .category-content {
            background: linear-gradient(135deg, #667eea, #764ba2) !important;
            border-bottom: none;
            padding: 16px !important;
            border-radius: 0 0 20px 20px;
            margin-bottom: 8px;
        }
        .sidebar-user .media-heading {
            color: #ffffff !important;
            font-weight: 700;
            font-size: 13px;
        }
        .sidebar-user .text-muted {
            color: rgba(255,255,255,0.75) !important;
        }
        .sidebar-user img {
            border: 2px solid rgba(255,255,255,0.6);
            border-radius: 50%;
        }

        /* Navigation items */
        .navigation-main > li > a {
            color: #4a5568 !important;
            border-radius: 10px;
            margin: 2px 10px;
            padding: 10px 14px !important;
            transition: all 0.25s ease;
            font-size: 13px;
            font-weight: 500;
        }
        .navigation-main > li > a:hover {
            background: linear-gradient(135deg, rgba(102,126,234,0.12), rgba(118,75,162,0.08)) !important;
            color: #667eea !important;
            transform: translateX(4px);
        }
        .navigation-main > li > a i {
            color: #a0aec0;
            margin-right: 10px;
            width: 18px;
            text-align: center;
            transition: color 0.2s;
        }
        .navigation-main > li > a:hover i {
            color: #667eea;
        }

        /* Active menu item */
        .navigation-main > li.active > a,
        .navigation-main > li > a.active {
            background: linear-gradient(135deg, rgba(102,126,234,0.15), rgba(118,75,162,0.1)) !important;
            color: #667eea !important;
            border-left: 3px solid #667eea;
            border-radius: 0 10px 10px 0;
            margin-left: 10px;
            font-weight: 600;
        }
        .navigation-main > li.active > a i {
            color: #667eea;
        }

        /* Submenu */
        .navigation-main .navigation-submenu > li > a {
            color: #718096 !important;
            padding-left: 42px !important;
            font-size: 12px;
            border-radius: 8px;
            margin: 1px 10px;
        }
        .navigation-main .navigation-submenu > li > a:hover {
            background: rgba(102,126,234,0.08) !important;
            color: #667eea !important;
        }

        /* Scrollbar */
        .sidebar-content::-webkit-scrollbar { width: 4px; }
        .sidebar-content::-webkit-scrollbar-track { background: transparent; }
        .sidebar-content::-webkit-scrollbar-thumb { background: rgba(102,126,234,0.3); border-radius: 4px; }


        /* ===== MOBILE ===== */
        @media (max-width: 767px) {
            .visible-xs-block > li > a {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            .visible-xs-block {
                padding-left: 170px !important;
            }

            .sidebar-mobile-main-toggle i {
                position: relative;
                top: -1px;
                margin-left: -150px;
            }

            .navbar-nav > li.dropdown-user {
                position: relative !important;
            }

            .navbar-nav > li.dropdown-user > .dropdown-menu {
                position: absolute !important;
                top: 100% !important;
                right: 0 !important;
                left: auto !important;
                min-width: 180px;
                z-index: 2000;
                float: none;
                margin-top: 0 !important;
                border-top: 0 !important;
            }

            .navbar-nav > li.dropdown-user > a {
                padding-bottom: 0 !important;
                margin-bottom: 0 !important;
                line-height: 30px !important;
            }

            .navbar,
            .navbar-collapse {
                overflow: visible !important;
            }

            .navbar.navbar-fixed-top {
                height: 56px !important;
                min-height: 56px !important;
            }

            .navbar-collapse {
                display: flex !important;
                align-items: center !important;
                justify-content: space-between !important;
                height: 56px !important;
                min-height: 56px !important;
                padding: 0 !important;
                overflow: visible !important;
                background: linear-gradient(135deg, #667eea, #764ba2) !important;
                border-top: 0 !important;
                flex-wrap: nowrap !important;
            }

            .navbar-nav > li > a,
            .navbar-text {
                line-height: 56px !important;
                padding-top: 0 !important;
                padding-bottom: 0 !important;
                background-color: transparent !important;
            }

            .navbar-header {
                display: flex;
                align-items: center;
                gap: 10px;
                background: linear-gradient(135deg, #667eea, #764ba2);
            }

            .navbar-brand img {
                height: 36px !important;
                padding: 0 !important;
                margin-top: -2px;
            }

            .brand-text {
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                line-height: 1;
                white-space: nowrap;
            }

            .visible-xs-block {
                display: flex !important;
                margin: 0 !important;
            }

            .icon-tree5 {
                display: none !important;
            }

            .navbar-nav {
                display: flex !important;
                flex-direction: row !important;
                margin: 0 !important;
            }

            .navbar-text {
                margin: 0 6px !important;
                font-size: 11px;
                white-space: nowrap;
                position: static !important;
                background-color: transparent !important;
                box-shadow: none !important;
            }

            .navbar-right {
                display: flex !important;
                align-items: center;
                gap: 6px;
                margin: 0 !important;
                margin-left: auto !important;
                margin-right: -10px !important;
            }

            .dropdown-user > a {
                display: flex !important;
                align-items: center;
                gap: 5px;
                padding: 4px 6px;
                padding-right: 10px !important;
            }

            .dropdown-user img {
                height: 28px;
                width: 28px;
            }

            .navbar,
            .navbar * {
                white-space: nowrap;
            }

            .navbar-inverse .navbar-nav > .dropdown-user.open > .dropdown-menu,
            .navbar-inverse .navbar-nav > .dropdown-user > .dropdown-menu {
                background-color: #fff;
                border-color: rgba(102,126,234,0.2) !important;
            }

            .navbar-inverse .navbar-nav > .dropdown-user > .dropdown-menu > li > a {
                color: #333 !important;
            }

            .navbar-inverse .navbar-nav > .dropdown-user > .dropdown-menu > li > a:hover {
                background-color: #f5f5f5 !important;
                color: #667eea !important;
            }

            .navbar.navbar-fixed-top {
                position: fixed !important;
                top: 0;
                left: 0;
                right: 0;
                width: 100%;
                z-index: 1050;
            }

            .page-content {
                padding-top: 100px !important;
            }

            .navbar-inverse .navbar-collapse {
                background: linear-gradient(135deg, #667eea, #764ba2) !important;
                border-top: 0 !important;
                margin-top: -8px;
            }

            .sidebar-content {
                background: linear-gradient(180deg, #f8f9ff, #f0f2ff) !important;
            }
        }

        @media (min-width: 768px) {
            .page-title .title-left { text-align: left !important; }
            .page-title .title-right { text-align: right !important; }
            
            /* Sticky sidebar fix */
            .sidebar-main {
                position: -webkit-sticky; /* For Safari */
                position: sticky;
                top: 56px; /* Navbar height offset */
                height: calc(100vh - 56px);
                overflow-y: auto;
            }
        }
    </style>

    <script type="text/javascript">
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-bottom-right",
            "timeOut": "3000"
        };

        function showToastr(type, message) {
            toastr[type](message);
        }
    </script>
        <script type="text/javascript">
            function myFunction() {
                window.location.reload();
            }

            $(document).ready(function() {
                // Fix for datatable search/pagination scrolling issue
                setTimeout(function() {
                    $('.dataTables_wrapper').each(function() {
                        if ($(this).parent().hasClass('table-responsive')) {
                            $(this).unwrap();
                        }
                    });
                }, 500);
            });
        </script>
